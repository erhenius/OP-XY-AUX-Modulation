+"""Bound the decoder exception to the authenticated bytes and their ELF symbol."""
+import unittest
+from unittest.mock import patch
+from tooling.aux_lfo_review import recognize_duck
+from tooling.formats import sha
+
+
+class DuckCode(unittest.TestCase):
+    def test_known_graft_only(self):
+        base = 0x10000
+        body = bytes(682)
+        image = b'xyz!' + body + b'next'
+        symbols = {'sdk_aux_duck_kernel': {'value': base + 4, 'size': len(body), 'type': 2}}
+        text = {'address': base, 'size': len(image)}
+        listing = '10000: ILLEGAL\n10004: ILLEGAL\n102ac: ILLEGAL\n102ae: ILLEGAL\n'
+        def review(data):
+            return recognize_duck(listing, {'module_base': base}, symbols, data, text)
+        with patch('tooling.aux_lfo_review.NATIVE_SHA', sha(body)):
+            output = review(image)
+            self.assertIn('10000: ILLEGAL', output)
+            self.assertIn('102ae: ILLEGAL', output)
+            self.assertIn('10004: BLACKFIN_PLUS_STOCK', output)
+            self.assertIn('102ac: BLACKFIN_PLUS_STOCK', output)
+            with self.assertRaises(ValueError):
+                review(image[:5] + b'!' + image[6:])
+            symbols['sdk_aux_duck_kernel']['size'] += 1
+            with self.assertRaises(ValueError):
+                review(image)
