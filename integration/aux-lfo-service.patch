+++ b/tooling/aux_lfo_review.py
@@ -0,0 +1,21 @@
+"""Authorize decoder limitations only inside the byte-exact OS 1.2.1 Duck graft."""
+import re
+from .aux_lfo_duck_stock import NATIVE_SHA
+from .formats import require, sha
+
+
+def recognize_duck(disassembly, profile, symbols, module, text):
+    symbol = symbols.get('sdk_aux_duck_kernel', {})
+    begin, size = symbol.get('value', 0), symbol.get('size', 0)
+    offset = begin - profile['module_base']
+    require(symbol.get('type') == 2 and size == 682 and 0 <= offset and
+            offset + size <= len(module) and text['address'] <= begin and
+            begin + size <= text['address'] + text['size'] and
+            sha(module[offset:offset + size]) == NATIVE_SHA,
+            'Changed or unbounded native Duck routine')
+    # The pinned disassembler decodes most existing Blackfin+ stock opcodes.
+    # Keep every row and relocation. Annotate its unknown-opcode diagnostic
+    # only when the address lies in this exact authenticated routine.
+    def label(match):
+        return match[0].replace('ILLEGAL', 'BLACKFIN_PLUS_STOCK') if begin <= int(match[1], 16) < begin + size else match[0]
+    return re.sub(r'^\s*([0-9a-f]+):[^\n]*\bILLEGAL\b[^\n]*', label, disassembly, flags=re.MULTILINE)
