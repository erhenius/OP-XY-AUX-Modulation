diff --git a/sdk/platform/opxy-1.2.1/aux_value_random.hpp b/sdk/platform/opxy-1.2.1/aux_value_random.hpp
new file mode 100644
index 0000000..7c0c194
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_value_random.hpp
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <opxy/q31.hpp>
+
+namespace aux_lfo {
+
+struct ValueRandomState {
+    opxy::u32 phase;
+    opxy::u32 sequence;
+    opxy::i32 held;
+    opxy::i32 smoothed;
+};
+
+inline void reset_value_random(ValueRandomState &state, opxy::u32 seed) {
+    state.phase = 0;
+    state.sequence = seed;
+    state.held = 0;
+    state.smoothed = 0;
+}
+
+// OS 1.2.1 instrument Value and Random interpret their rate word identically.
+inline opxy::u32 value_random_increment(opxy::i32 rate_word, opxy::u32 stock_tempo_increment) {
+    const opxy::u32 rate = rate_word > 0 ? static_cast<opxy::u32>(rate_word) >> 17 : 0;
+    if (rate < 8192u) return stock_tempo_increment >> (rate >> 10);
+    const opxy::i32 distance = static_cast<opxy::i32>(rate - 8192u) * 65536;
+    return static_cast<opxy::u32>(opxy::q31::multiply(distance, distance));
+}
+
+// One control sample at the start of the stock 64-sample Value block.
+// The instrument divides its phase step by 64 before advancing waveform samples.
+inline opxy::i32 value_wave(ValueRandomState &state, opxy::u32 increment, opxy::u32 shape,
+                            const volatile opxy::i16 *sine_table) {
+    const opxy::u32 phase = state.phase;
+    state.phase += increment & ~63u;
+    switch (shape) {
+        case 0: return static_cast<opxy::i32>(sine_table[phase >> 19]) * 65536;
+        case 1: return (phase & 0x80000000u) ? (-2147483647 - 1) : 2147418112;
+        case 2: return static_cast<opxy::i32>((65535u - (phase >> 16)) >> 1) * 65536;
+        case 3: return static_cast<opxy::i32>((phase >> 16) >> 1) * 65536;
+        default: return 0;
+    }
+}
+
+inline opxy::i32 random_sample_blend(opxy::u32 increment) {
+    const opxy::i32 base = 16777216;
+    const opxy::u32 threshold = 21474836;
+    if (increment <= threshold) return base;
+    // The native evaluator supports signed positive increments. A caller may use
+    // the entire unsigned range to fast-forward the clock; clamp for the blend.
+    const opxy::i32 limited = increment > 2147483647u ? 2147483647 : static_cast<opxy::i32>(increment);
+    const opxy::i32 distance = limited - static_cast<opxy::i32>(threshold);
+    return base + opxy::q31::multiply(opxy::q31::shift_left(distance, 5), 268435456);
+}
+
+inline opxy::i32 random_wave(ValueRandomState &state, opxy::u32 increment) {
+    const opxy::u32 previous = state.phase;
+    state.phase += increment;
+    if (state.phase < previous) {
+        state.sequence = state.sequence * 1664525u + 1013904223u;
+        const opxy::i32 high = static_cast<opxy::i32>(state.sequence >> 16);
+        state.held = (high >= 32768 ? high - 65536 : high) * 65536;
+    }
+    if (state.smoothed == state.held) return state.smoothed;
+
+    // Advance the one-pole through 64 native samples with six Q31 squares.
+    // This is an end-of-block control sample. Intermediate audio samples are
+    // unnecessary for AUX modulation; fixed-point rounding differs by a few LSBs.
+    opxy::i32 old_weight = opxy::q31::maximum - random_sample_blend(increment);
+    for (unsigned power = 0; power < 6; ++power) {
+        old_weight = opxy::q31::multiply(old_weight, old_weight);
+    }
+    state.smoothed = opxy::q31::add(opxy::q31::multiply(old_weight, state.smoothed),
+                                    opxy::q31::multiply(opxy::q31::maximum - old_weight, state.held));
+    return state.smoothed;
+}
+
+}  // namespace aux_lfo
diff --git a/sdk/platform/opxy-1.2.1/aux_value_random_stock.hpp b/sdk/platform/opxy-1.2.1/aux_value_random_stock.hpp
new file mode 100644
index 0000000..f1613c3
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_value_random_stock.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "aux_value_random.hpp"
+
+namespace aux_lfo {
+
+// Audio CPU, OS 1.2.1 only. Callers must authenticate the OS profile before
+// installing the binding. These aliases use read-only native data.
+inline opxy::u32 value_random_stock_increment(opxy::i32 rate_word) {
+    const volatile opxy::u32 *tempo = reinterpret_cast<const volatile opxy::u32 *>(0x840426f4u);
+    return value_random_increment(rate_word, *tempo);
+}
+
+inline opxy::i32 value_wave_stock(ValueRandomState &state, opxy::i32 rate_word, opxy::u32 shape) {
+    const volatile opxy::i16 *sine = reinterpret_cast<const volatile opxy::i16 *>(0x84048aa4u);
+    return value_wave(state, value_random_stock_increment(rate_word), shape, sine);
+}
+
+inline opxy::i32 random_wave_stock(ValueRandomState &state, opxy::i32 rate_word) {
+    return random_wave(state, value_random_stock_increment(rate_word));
+}
+
+}  // namespace aux_lfo
diff --git a/sdk/platform/opxy-1.2.1/element.hpp b/sdk/platform/opxy-1.2.1/element.hpp
new file mode 100644
index 0000000..e2d5c59
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/element.hpp
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <opxy/q31.hpp>
+
+namespace aux_lfo {
+
+inline opxy::i32 gyro_q31(opxy::i16 motion) {
+    const opxy::i32 reversed = -static_cast<opxy::i32>(motion);
+    return (reversed > 32767 ? 32767 : reversed) * 65536;
+}
+
+// Read only on the audio role. The stock DMA service records this cycle pair
+// before each input callback, including a callback with no input buffer.
+struct CaptureStamp {
+    opxy::u32 low;
+    opxy::u32 high;
+};
+
+struct ElementMic {
+    opxy::i32 first;
+    opxy::i32 second;
+    CaptureStamp captured;
+    bool active;
+};
+
+// Stock Element computes two cascaded Q31 one-pole followers. The fixed
+// coefficients below are derived from the stock 10/200 ms defaults at 44.1 kHz
+// (1% remaining after the nominal time). No floating point in audio.
+inline opxy::i32 mic_pole(opxy::i32 old, opxy::i32 target) {
+    const opxy::i32 coefficient = old < target ? 2125175096 : 2146362679;
+    // Both operands lie in [0, INT_MAX], so neither the difference nor
+    // target + the weighted difference can overflow.
+    return target + opxy::q31::multiply(old - target, coefficient);
+}
+
+inline void mic_observe(ElementMic& state, const opxy::i32* pairs,
+                        bool internal_mic, CaptureStamp stamp) {
+    state.active = internal_mic && pairs;
+    state.captured = stamp;
+    if (!internal_mic || !pairs) {
+        state.first = state.second = 0;
+        return;
+    }
+    for (unsigned i = 0; i < 64; ++i) {
+        // Same ordering as instrument Element: abs(max(a,b)).
+        const opxy::i32 a = *pairs++;
+        const opxy::i32 b = *pairs++;
+        const opxy::i32 max = a > b ? a : b;
+        const opxy::i32 magnitude = max >= 0 ? max :
+            (max == -2147483647 - 1 ? 2147483647 : -max);
+        state.first = mic_pole(state.first, magnitude);
+        state.second = mic_pole(state.second, state.first);
+    }
+}
+
+inline opxy::i32 mic_read(ElementMic& state, CaptureStamp current) {
+    const bool fresh = state.active && current.low == state.captured.low &&
+                       current.high == state.captured.high;
+    if (!fresh) state.first = state.second = 0;
+    return state.second;
+}
+
+} // namespace aux_lfo
