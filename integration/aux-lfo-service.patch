diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_common.hpp b/sdk/platform/opxy-1.2.1/aux_lfo_common.hpp
new file mode 100644
index 0000000..c27d1ee
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_common.hpp
@@ -0,0 +1,18 @@
+#pragma once
+#include <opxy/types.hpp>
+namespace aux_lfo {
+using opxy::i32;
+using opxy::u32;
+using opxy::u8;
+enum Source { Stock, Gyro, Mic, Duck, Sine, Square, Falling, Rising, Random, DuckNote, SourceCount };
+const u32 targets = 3, patterns = 16;
+inline u32 index(u32 track) { return track == 11 ? 0 : track == 14 ? 1 : track == 15 ? 2 : targets; }
+inline bool tagged(i32 word) {
+    const u32 value = static_cast<u32>(word);
+    const u32 mode = value & 15u;
+    return (value & 0xfff00000u) == 0x4af00000u && mode > Stock && mode < SourceCount;
+}
+inline i32 token(u32 generation, u32 mode) {
+    return static_cast<i32>(0x4af00000u | ((generation & 0xffffu) << 4) | mode);
+}
+}
diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_display.hpp b/sdk/platform/opxy-1.2.1/aux_lfo_display.hpp
new file mode 100644
index 0000000..38d6579
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_display.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include "aux_lfo_common.hpp"
+
+namespace aux_lfo {
+enum StockPage { ValuePage = 27, RandomPage, ElementPage, DuckPage };
+inline i32 display_page(u32 source) {
+    switch (source) {
+    case Gyro: case Mic: return ElementPage;
+    case Duck: case DuckNote: return DuckPage;
+    case Sine: case Square: case Falling: case Rising: return ValuePage;
+    case Random: return RandomPage;
+    default: return -1;
+    }
+}
+// Return the middle of a stock selector bucket in nonnegative Q31.
+inline i32 sixth(u32 choice) {
+    const i32 middle[] = {178956970, 536870912, 894784853, 1252698794, 1610612736, 1968526677};
+    return middle[choice];
+}
+inline u32 aux_group(i32 value) {
+    // As in the AUX destination resolver: ((word >> 8) * 3) >> 23.
+    return value <= 0 ? 0 : ((static_cast<u32>(value) >> 8) * 3) >> 23;
+}
+inline void display_words(u32 mode, const i32* in, i32 (&out)[8]) {
+    for (u32 i = 0; i != 8; ++i) out[i] = in[i];
+    if (mode == Duck || mode == DuckNote) {
+        out[4] = mode == DuckNote ? 2147483647 : 0;
+        return;
+    }
+    const u32 group = aux_group(in[2]);
+    if (mode == Gyro || mode == Mic) {
+        out[0] = mode == Mic ? 0x20000000 : 0;
+        out[2] = static_cast<i32>((group << 29) + 0x10000000);
+        return;
+    }
+    // Value and Random are free-running on AUX. Their original pages offer
+    // two positions per destination group, with free in the second position.
+    out[2] = sixth(2 * group + 1);
+    if (mode == Random) {
+        out[7] = in[3]; // Random renders its destination slot from word 31.
+        out[3] = 0x40000000; // No instrument-triggered fade on the AUX oscillator.
+    }
+    else if (mode >= Sine && mode <= Rising) out[4] = static_cast<i32>((mode - Sine) << 29);
+}
+}
diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_duck.hpp b/sdk/platform/opxy-1.2.1/aux_lfo_duck.hpp
new file mode 100644
index 0000000..bf3088a
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_duck.hpp
@@ -0,0 +1,60 @@
+#pragma once
+#include <opxy/q31.hpp>
+
+namespace aux_lfo {
+using opxy::i32;
+
+struct DuckControls {
+    i32 source, amount, hold, release, source_type; // stock non-negative Q31 words
+};
+
+struct DuckState {
+    // Native accesses use offsets relative to the start of this buffer.
+    // 0x80..0x87 hold two histories; 0x88 holds the first of 64 per-sample results.
+    i32 kernel[0x88 / sizeof(i32) + 64];
+    i32 words[29]; // Stock parameter block through source-type word 28.
+    bool initialized;
+};
+
+extern "C" void sdk_aux_duck_kernel(i32* state, unsigned private_index,
+                                    const i32* controls) __asm__("sdk_aux_duck_kernel");
+
+inline void duck_reset(DuckState& s) {
+    // Clear on *entry*, once. A BSS-zeroed instance has the same behaviour.
+    s.initialized = false;
+}
+
+inline i32 duck_step(DuckState& s, const DuckControls& controls) {
+    const i32 amount = controls.amount < 0 ? 0 : controls.amount;
+    const i32 hold = controls.hold < 0 ? 0 : controls.hold;
+    const i32 release = controls.release < 0 ? 0 : controls.release;
+    const bool new_coefficients = !s.initialized || s.words[25] != amount ||
+                                 s.words[26] != hold || s.words[27] != release;
+    if (!s.initialized) {
+        for (auto& value : s.kernel) value = 0;
+        s.kernel[0x78 / 4] = 1; // Stock refreshes the stages from the pristine histories.
+        s.initialized = true;
+    }
+    s.words[24] = controls.source < 0 ? 0 : controls.source;
+    s.words[25] = amount;
+    s.words[26] = hold;
+    s.words[27] = release;
+    s.words[28] = controls.source_type < 0 ? 0 : controls.source_type;
+    // Stock's compare uses the hold word, but its compute branch stores amount.
+    // Recompute on edits to any coefficient input and reuse them while steady.
+    s.kernel[0x70 / 4] = new_coefficients ? -1 : hold;
+    s.kernel[0x74 / 4] = release;
+    sdk_aux_duck_kernel(s.kernel, 0, s.words);
+    // Instrument volume's stock destination consumes the first sample of the output block.
+    // A positive result cannot duck. Bound unexpected input to unity (no change).
+    const i32 raw = s.kernel[0x88 / 4];
+    return raw < 0 ? opxy::q31::multiply(raw, amount) : 0;
+}
+
+inline i32 duck_delta(i32 base, i32 depth_scaled_envelope) {
+    // The AUX destination takes an additive delta; the equivalent of ducking
+    // a normalized control by a fractional amount is base * (-attenuation).
+    return base > 0 && depth_scaled_envelope < 0
+        ? opxy::q31::multiply(base, depth_scaled_envelope) : 0;
+}
+}
diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_element.cpp b/sdk/platform/opxy-1.2.1/aux_lfo_element.cpp
new file mode 100644
index 0000000..3dba9f5
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_element.cpp
@@ -0,0 +1,40 @@
+#include "element_stock.hpp"
+
+namespace {
+
+aux_lfo::ElementMic mic;
+bool using_internal_lane;
+
+bool mic_selected(unsigned track) {
+    const opxy::u32 address = 0x84eab39cu + 4u * (58u * track + 57u);
+    return (opxy::platform::word(address) & 0xfff0000fu) == 0x4af00002u;
+}
+
+aux_lfo::CaptureStamp capture_stamp() {
+    // 11a02a04 / 11a02a06 write these two words before calling 8d4ff32c.
+    // Producer and consumer run serially on the audio role.
+    return {opxy::platform::word(0x08034f68), opxy::platform::word(0x08034f6c)};
+}
+
+} // namespace
+
+opxy::i32 aux_lfo::mic_q31_from_stock() {
+    return mic_read(mic, capture_stamp());
+}
+
+opxy::u32 aux_lfo_mic_input_lane() {
+    const opxy::u32 original = opxy::platform::stock<opxy::u32()>(0x8d4db364)();
+    using_internal_lane = original == 0;
+    return original;
+}
+
+void aux_lfo_observe_mic(opxy::u32 source, const opxy::i32* pairs) {
+    const bool internal = using_internal_lane && source == 14 && pairs;
+    using_internal_lane = false;
+    if (mic_selected(11) || mic_selected(14) || mic_selected(15)) {
+        aux_lfo::mic_observe(mic, pairs, internal, capture_stamp());
+    } else if (mic.active) {
+        mic = {};
+    }
+    opxy::platform::stock<void(opxy::u32, const opxy::i32*)>(0x8d51a3c8)(source, pairs);
+}
diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_hooks.s b/sdk/platform/opxy-1.2.1/aux_lfo_hooks.s
new file mode 100644
index 0000000..3ff30f9
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_hooks.s
@@ -0,0 +1,54 @@
+.section .text
+.align 2
+.extern sdk_aux_lfo_evaluate
+.global sdk_aux_lfo_resolve
+.type sdk_aux_lfo_resolve, STT_FUNC
+sdk_aux_lfo_resolve:
+    /* A tagged live word is published only for a selected, owned source. */
+    R3 = [P2 + 228];
+    R3 >>= 20;
+    R0 = 0x4af (Z);
+    CC = R3 == R0;
+    IF CC JUMP 1f;
+    P1.L = 0xf348;
+    P1.H = 0x8d50;
+    JUMP (P1);
+1:
+    LINK 20;
+    [SP] = R7;
+    [SP + 4] = R1;
+    [SP + 8] = R5;
+    [SP + 12] = R6;
+    SP += -12;
+    P1.L = 0xf348;
+    P1.H = 0x8d50;
+    CALL (P1);
+    SP += 12;
+    [SP + 16] = R0;
+    R0 = SP;
+    SP += -12;
+    CALL sdk_aux_lfo_evaluate;
+    SP += 12;
+    R5 = [SP + 8];
+    R6 = [SP + 12];
+    R0 = [SP + 16];
+    UNLINK;
+    RTS;
+.size sdk_aux_lfo_resolve, .-sdk_aux_lfo_resolve
+
+/* Stock's shifted AUX controller dispatches M4 (key 9) to its own handled
+ * return. Like the adjacent SDK Shift+M1 case, the stock method has LINK 12
+ * and no saved registers. Return handled even on unrelated tracks. */
+.extern sdk_aux_lfo_shift_m4
+.global sdk_aux_lfo_shift_m4_hook
+.type sdk_aux_lfo_shift_m4_hook, STT_FUNC
+sdk_aux_lfo_shift_m4_hook:
+    LINK 0;
+    SP += -12;
+    CALL sdk_aux_lfo_shift_m4;
+    SP += 12;
+    UNLINK;
+    UNLINK;
+    R0 = 1;
+    RTS;
+.size sdk_aux_lfo_shift_m4_hook, .-sdk_aux_lfo_shift_m4_hook
diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_runtime.cpp b/sdk/platform/opxy-1.2.1/aux_lfo_runtime.cpp
new file mode 100644
index 0000000..bdb2aa4
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_runtime.cpp
@@ -0,0 +1,40 @@
+// OS 1.2.1 audio-side AUX control evaluator, one invocation per enabled AUX tick.
+#include "aux_lfo_common.hpp"
+#include "aux_lfo_duck.hpp"
+#include "aux_value_random_stock.hpp"
+#include "element_stock.hpp"
+
+namespace aux_lfo {
+struct Frame { u32 track; const i32* words; i32 depth, wave; u32 slot; };
+static_assert(sizeof(void*) != 4 || sizeof(Frame) == 20, "Blackfin callback layout");
+struct Voice { DuckState duck; ValueRandomState oscillator; i32 tag; };
+Voice voices[targets];
+
+extern "C" void sdk_aux_lfo_evaluate(Frame*) __asm__("sdk_aux_lfo_evaluate");
+extern "C" void sdk_aux_lfo_evaluate(Frame* f) {
+    const u32 n = index(f->track);
+    if (n >= targets || !f->words) return;
+    const i32 tag = f->words[57];
+    const u32 mode = static_cast<u32>(tag) & 15u;
+    if (!tagged(tag) || !mode || mode >= SourceCount) return;
+    Voice& v = voices[n];
+    if (v.tag != tag) {
+        v.tag = tag;
+        reset_value_random(v.oscillator, 0x9e3779b9u * (n + 1u));
+        duck_reset(v.duck);
+    }
+    if (mode == Gyro) f->wave = gyro_q31_from_stock();
+    else if (mode == Mic) f->wave = mic_q31_from_stock();
+    else if (mode == Random) f->wave = random_wave_stock(v.oscillator, f->words[24]);
+    else if (mode >= Sine && mode <= Rising) f->wave = value_wave_stock(v.oscillator, f->words[24], mode - Sine);
+    else if (mode == Duck || mode == DuckNote) {
+        const DuckControls controls = {f->words[24], f->words[25], f->words[26], f->words[27],
+                                       mode == DuckNote ? 2147483647 : 0};
+        f->slot = f->track == 11 ? 3u : 41u;
+        // Instrument Duck's raw amount is unipolar. The AUX post-hook
+        // multiplier therefore uses unity after applying that amount once.
+        f->wave = duck_delta(f->words[f->slot], duck_step(v.duck, controls));
+        f->depth = 2147483647;
+    }
+}
+}
diff --git a/sdk/platform/opxy-1.2.1/aux_lfo_ui.inc b/sdk/platform/opxy-1.2.1/aux_lfo_ui.inc
new file mode 100644
index 0000000..94740ab
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/aux_lfo_ui.inc
@@ -0,0 +1,111 @@
+// GUI side; called from the existing AUX service. A source belongs to a target's
+// current pattern. Exchange only a tagged live word with the audio role.
+using opxy::u8;
+u8 mode_bank[aux_lfo::targets][aux_lfo::patterns];
+struct PublishedMode { u32 pattern, mode, generation; };
+PublishedMode publications[aux_lfo::targets];
+u32 lifecycle;
+enum Family { Plain, DuckFamily, ElementFamily, RandomFamily, ValueFamily, FamilyCount };
+const char* const family_names[FamilyCount] = {"stock", "duck", "element", "random", "value"};
+const aux_lfo::Source family_defaults[FamilyCount] = {
+    aux_lfo::Stock, aux_lfo::Duck, aux_lfo::Gyro, aux_lfo::Random, aux_lfo::Sine
+};
+// Companion files and the GUI/audio handoff keep the A2 source IDs.
+Family family_of(u32 source) {
+    switch (source) {
+    case aux_lfo::Duck: case aux_lfo::DuckNote: return DuckFamily;
+    case aux_lfo::Gyro: case aux_lfo::Mic: return ElementFamily;
+    case aux_lfo::Random: return RandomFamily;
+    case aux_lfo::Sine: case aux_lfo::Square: case aux_lfo::Falling: case aux_lfo::Rising: return ValueFamily;
+    default: return Plain;
+    }
+}
+browser::StockSelector<FamilyCount> mode_selector;
+struct ModeSelection { u32 track, pattern, project, block, lifecycle; };
+ModeSelection selection;
+bool modulation_track(u32 track) {
+    if (track == 14 || track == 15) return true;
+    if (track != kCv) return false;
+    const ControlMachine* m = holder(track);
+    if (!m || !m->shared_lfo || !m->name) return false;
+    const char name[] = "morphcapture";
+    for (u32 n = 0; n < sizeof name; ++n) if (m->name[n] != name[n]) return false;
+    return true;
+}
+void store_modulation(u32 track, u32 pattern, u32 source) {
+    u8& saved = mode_bank[aux_lfo::index(track)][pattern];
+    if (saved == source) return;
+    saved = static_cast<u8>(source);
+    // Project dirty byte and edit counter, as GUI engine setter 0x8d5877e4.
+    *at<volatile u8>(0x840a052c) = 1;
+    ++*at<volatile u32>(0x840a0530);
+}
+void choose_modulation(void*, u32 family) {
+    const u32 t = selection.track;
+    if (family >= FamilyCount || word(kProjectLoading) || selection.lifecycle != lifecycle ||
+        selection.project != word(0x840a0524) || t != byte(kSelectedTrack) ||
+        selection.block != current_block(t) || !modulation_track(t)) return;
+    if (family != family_of(mode_bank[aux_lfo::index(t)][selection.pattern]))
+        store_modulation(t, selection.pattern, family_defaults[family]);
+}
+// Return the active source on the selected target's M4. Plain AUX or the
+// machine's own pages retain their normal controls.
+u32 editable_modulation(u32 track) {
+    if (word(kAuxTab) != 3 || !word(0x840a0524) || word(kProjectLoading) || !modulation_track(track))
+        return aux_lfo::Stock;
+    const u32 pattern = current_pattern(track);
+    return pattern < aux_lfo::patterns ? mode_bank[aux_lfo::index(track)][pattern] : aux_lfo::Stock;
+}
+bool modulation_k1_click(u32 track) {
+    const u32 source = editable_modulation(track);
+    u32 next;
+    if (source == aux_lfo::Duck || source == aux_lfo::DuckNote)
+        next = source == aux_lfo::Duck ? aux_lfo::DuckNote : aux_lfo::Duck;
+    else if (source >= aux_lfo::Sine && source <= aux_lfo::Rising)
+        next = source == aux_lfo::Rising ? aux_lfo::Sine : source + 1;
+    else return false;
+    store_modulation(track, current_pattern(track), next);
+    return true;
+}
+bool modulation_element_turn(u32 track, u32 event) {
+    const u32 source = editable_modulation(track);
+    if (source != aux_lfo::Gyro && source != aux_lfo::Mic) return false;
+    const i32 detents = at<const i32>(event)[1];
+    if (detents) store_modulation(track, current_pattern(track), detents > 0 ? aux_lfo::Mic : aux_lfo::Gyro);
+    return true;
+}
+bool open_modulation(u32 track) {
+    if (word(kProjectLoading) || !word(0x840a0524) || !modulation_track(track)) return false;
+    const u32 pattern = current_pattern(track);
+    if (pattern >= aux_lfo::patterns) return false;
+    const ModeSelection next = {track, pattern, word(0x840a0524), current_block(track), lifecycle};
+    const browser::Callbacks callbacks = {nullptr, choose_modulation, nullptr, nullptr};
+    if (!mode_selector.open("lfo", family_names, FamilyCount, family_of(mode_bank[aux_lfo::index(track)][pattern]), callbacks, track)) return false;
+    selection = next;
+    return true;
+}
+i32 modulation_mark(u32 track, i32 fallback) {
+    const u32 target = aux_lfo::index(track);
+    if (target >= aux_lfo::targets) return fallback;
+    const u32 pattern = current_pattern(track);
+    const u32 mode = pattern < aux_lfo::patterns && !word(kProjectLoading) && modulation_track(track) && byte(current_block(track) + 0x24)
+                     ? mode_bank[target][pattern] : 0;
+    PublishedMode& p = publications[target];
+    if (mode != p.mode || pattern != p.pattern) { ++p.generation; p.mode = mode; p.pattern = pattern; }
+    return mode ? aux_lfo::token(p.generation, mode) : fallback;
+}
+void modulation_tick() {
+    if (!word(0x840a0524)) return;
+    // The CV role can be returned to plain CV between two visits to the
+    // same Morph pattern. A reacquisition must start fresh oscillator/Duck state.
+    if (publications[0].mode && !modulation_track(kCv)) {
+        publications[0].mode = 0;
+        ++publications[0].generation;
+    }
+    for (u32 t = 14; t <= 15; ++t) {
+        const i32 now = live(t, kMarkWord);
+        const i32 desired = modulation_mark(t, 0);
+        if (desired && now != desired) live_set(t, kMarkWord, desired);
+        else if (!desired && aux_lfo::tagged(now)) live_set(t, kMarkWord, base(t, kMarkWord));
+    }
+}
