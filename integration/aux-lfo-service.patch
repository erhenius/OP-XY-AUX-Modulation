     else if (last == kAuxRelease) cv_missing = kHeldCalls;
@@ -530,2 +552,14 @@ void sdk_aux_shift_m1() {
 
+#ifdef OPXY_AUX_LFO
+// Give a discrete Element source turn to its owner, then delegate other
+// turns to the same AUX dispatcher used by stock and installed machines.
+u32 sdk_aux_lfo_turn(u32 controller, u32 encoder, u32 event) {
