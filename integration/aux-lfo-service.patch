 // 8c08f610: Shift + track key on an aux track. On one a machine holds, its
@@ -543,3 +577,42 @@ bool owns_page(u32 track) {
 // Tabs inherited from another track/pattern resolve to the machine's page.
+#ifdef OPXY_AUX_LFO
+extern "C" u32 sdk_aux_lfo_screen_mode(u32 track) __asm__("sdk_aux_lfo_screen_mode");
+u32 sdk_aux_lfo_screen_mode(u32 track) {
+    if (aux_lfo::index(track) == aux_lfo::targets || track != byte(kSelectedTrack)) return aux_lfo::Stock;
+    return editable_modulation(track);
