+        ('Stock element display parameters on AUX', '0x8d53fade', '0x176d3a', 'fce385c1', 'sdk_aux_lfo_draw_element'),
+        ('Stock random display parameters on AUX', '0x8d540a9a', '0x177cf6', 'fce3a7b9', 'sdk_aux_lfo_draw_random'),
+        ('Stock value display parameters on AUX', '0x8d543220', '0x17a47c', 'fce3e4a5', 'sdk_aux_lfo_draw_value'),
+        ('AUX source and destination', '0x8d50f3f6', '0x146652', 'ffe3a9ff', 'sdk_aux_lfo_resolve'),
+        ('Microphone input lane used in this block', '0x8d4ff38c', '0x1365e8', 'fee3ecdf', 'aux_lfo_mic_input_lane'),
+        ('Physical mic observer', '0x8d4ff3c8', '0x136624', '00e300d8', 'aux_lfo_observe_mic'),
+    ):
+        profile['patches'].append(dict(kind='hook', name=name, address=address, file_offset=offset,
+                                       length=4, before=before, symbol=symbol, call=True, service='aux_lfo'))
