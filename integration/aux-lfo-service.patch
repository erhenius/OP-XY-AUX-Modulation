+
+namespace {
+// Draw calls on stock pages use the eight-word vector returned by 8d4d7de8.
+// The AUX M4 page uses that same getter. Only the caller's copy is adapted.
+struct LfoVector { u32 allocator; const i32 *begin, *end, *capacity; };
+static_assert(sizeof(void*) != 4 || sizeof(LfoVector) == 16, "Stock control vector");
+const LfoVector* lfo_display_vector(u32 track, i32 page) {
