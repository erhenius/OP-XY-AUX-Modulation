+def extension_memory(directory, machines, profile):
+    """Exclusive extension allocations contained in the existing SDK total, before alignment."""
+    amounts = {e.id: dict(initialized_bytes=0, state_bytes=0) for e in extensions_of(machines)}
+    private_services = profile.get('extension_private_services', {})
+    for name, machine, step in plan(machines, profile):
+        if machine is not None:
+            continue
+        owner = step.removeprefix('extension:') if step.startswith('extension:') else private_services.get(UNIT_SERVICES.get(step))
+        if owner is None:
+            continue
+        require(owner in amounts, 'Unselected extension owns ' + name)
+        data, state = object_memory(read(Path(directory) / name))
+        amounts[owner]['initialized_bytes'] += data
+        amounts[owner]['state_bytes'] += state
+    return amounts
+
+
